# Agentic Debugger Configuration
# These can also be set in .agentic-debugger.json

# Log level: debug, info, warn, error
AGENTIC_DEBUGGER_LOG_LEVEL=info

# Audit log file path
AGENTIC_DEBUGGER_AUDIT_LOG=~/.agentic-debugger/audit.log

# Expression evaluation timeout (ms)
AGENTIC_DEBUGGER_EVAL_TIMEOUT=10000

# Maximum concurrent sessions
AGENTIC_DEBUGGER_MAX_SESSIONS=10

# Process attachment policy: own, allowlist, unrestricted
AGENTIC_DEBUGGER_ALLOW_ATTACH=own

# Variable value redaction (comma-separated patterns)
AGENTIC_DEBUGGER_REDACT_PATTERNS=*password*,*secret*,*token*,*apikey*,*api_key*,*credential*,*private_key*,*connection_string*
